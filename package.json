{
  "name": "webshell-desktop",
  "version": "1.0.0",
  "description": "An open-source Electron desktop shell for remote web applications.",
  "main": "main.js",
  "homepage": "",
  "build": {
    "appId": "io.github.webshell.desktop",
    "productName": "WebShell Desktop",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "*.html",
      "default.license",
      "manifest.json",
      "favicon.*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "favicon.icns"
    },
    "dmg": {
      "title": "WebShell Desktop",
      "icon": "favicon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "./favicon.ico"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "favicon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "favicon.ico",
      "uninstallerIcon": "favicon.ico",
      "installerHeaderIcon": "favicon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "scripts": {
    "start": "electron .",
    "keypair": "node tools/generate-keypair.js",
    "license:generate": "node tools/generate-license.js",
    "config:sign": "node tools/sign-remote-config.js",
    "release-notes:generate": "node tools/generate-release-notes.js",
    "manifest:generate": "node tools/generate-manifest.js",
    "dist-win": "electron-builder --win --x64",
    "dist-linux": "electron-builder --linux --x64"
  },
  "repository": {
    "type": "git",
    "url": "main"
  },
  "keywords": [
    "electron",
    "angular"
  ],
  "author": "LingPort",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "electron-localshortcut": "^3.2.1",
    "qiao-is-online": "^1.0.6"
  },
  "devDependencies": {
    "electron": ">=40.0.0",
    "electron-builder": "^26.0.0"
  }
}
